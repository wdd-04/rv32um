module cache #(
    parameter INDEX_WIDTH = 4,
    parameter USE_DCACHE_BRAM = 0
)(
    input wire clk,
    input wire rst_n,
    input wire flush,
    input wire [31:0] addr,
    input wire [31:0] din,
    input wire we,
    input wire [3:0] byte_we,
    output reg [31:0] dout,
    output reg hit
);
    localparam TAG_WIDTH = 32 - INDEX_WIDTH - 2;
    localparam DEPTH = (1 << INDEX_WIDTH);

    reg [TAG_WIDTH-1:0] tag0 [0:DEPTH-1];
    reg valid0 [0:DEPTH-1];

    wire [INDEX_WIDTH-1:0] index = addr[INDEX_WIDTH+1:2];
    wire [7:0] bram_index = {{(8-INDEX_WIDTH){1'b0}}, index};
    wire [TAG_WIDTH-1:0] tag = addr[31:INDEX_WIDTH+2];

    reg [INDEX_WIDTH-1:0] rd_index;
    reg [TAG_WIDTH-1:0] rd_tag;
    reg rd_valid;

    wire rd_hit0 = rd_valid && valid0[rd_index] && (tag0[rd_index] == rd_tag);
    wire wr_hit0 = valid0[index] && (tag0[index] == tag);

    wire [63:0] bram_dout;
    wire [63:0] bram_dina = {32'b0, din};
    wire [7:0]  dcache_wea = we ? {4'b0000, byte_we} : 8'b00000000;

    generate
        if (USE_DCACHE_BRAM) begin : gen_dcache_data
            dcache_data_bram data_bram (
                .clka(clk),
                .ena(1'b1),
                .wea(dcache_wea),
                .addra(bram_index),
                .dina(bram_dina),
                .clkb(clk),
                .enb(1'b1),
                .addrb(bram_index),
                .doutb(bram_dout)
            );
        end else begin : gen_icache_data
            icache_data_bram data_bram (
                .clka(clk),
                .ena(1'b1),
                .wea(we),
                .addra(bram_index),
                .dina(bram_dina),
                .clkb(clk),
                .enb(1'b1),
                .addrb(bram_index),
                .doutb(bram_dout)
            );
        end
    endgenerate

    always @(*) begin
        hit = rd_hit0;
        dout = rd_hit0 ? bram_dout[31:0] : 32'b0;
    end

    integer i;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n || flush) begin
            rd_index <= {INDEX_WIDTH{1'b0}};
            rd_tag   <= {TAG_WIDTH{1'b0}};
            rd_valid <= 1'b0;
            for (i = 0; i < DEPTH; i = i + 1) begin
                valid0[i] <= 1'b0;
            end
        end else begin
            rd_index <= index;
            rd_tag   <= tag;
            rd_valid <= 1'b1;

            if (we) begin
                tag0[index]   <= tag;
                valid0[index] <= 1'b1;
            end
        end
    end
endmodule
