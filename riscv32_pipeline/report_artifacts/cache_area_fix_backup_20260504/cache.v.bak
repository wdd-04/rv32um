module cache #(
    parameter INDEX_WIDTH = 8,
    parameter USE_DCACHE_BRAM = 0
)(
    input wire clk,
    input wire rst_n,
    input wire flush,
    input wire [31:0] addr,
    input wire [31:0] din,
    input wire we,
    input wire [3:0] byte_we,
    output reg [31:0] dout,
    output reg hit
);
    localparam TAG_WIDTH = 32 - INDEX_WIDTH - 2;
    localparam DEPTH = (1 << INDEX_WIDTH);

    reg [TAG_WIDTH-1:0] tag0 [0:DEPTH-1];
    reg [TAG_WIDTH-1:0] tag1 [0:DEPTH-1];
    reg valid0 [0:DEPTH-1];
    reg valid1 [0:DEPTH-1];
    reg lru [0:DEPTH-1];

    wire [INDEX_WIDTH-1:0] index = addr[INDEX_WIDTH+1:2];
    wire [TAG_WIDTH-1:0] tag = addr[31:INDEX_WIDTH+2];

    reg [INDEX_WIDTH-1:0] rd_index;
    reg [TAG_WIDTH-1:0] rd_tag;
    reg rd_valid;

    wire rd_hit0 = rd_valid && valid0[rd_index] && (tag0[rd_index] == rd_tag);
    wire rd_hit1 = rd_valid && valid1[rd_index] && (tag1[rd_index] == rd_tag);

    wire wr_hit0 = valid0[index] && (tag0[index] == tag);
    wire wr_hit1 = valid1[index] && (tag1[index] == tag);
    wire wr_miss = !wr_hit0 && !wr_hit1;
    wire wr_way1 = wr_hit1 || (wr_miss && lru[index]);
    wire wr_way0 = wr_hit0 || (wr_miss && !lru[index]);

    wire [63:0] bram_dout;
    wire [63:0] bram_dina = wr_way1 ? {din, 32'b0} : {32'b0, din};
    wire [7:0]  dcache_wea = we ? (wr_way1 ? {byte_we, 4'b0000} : {4'b0000, byte_we}) : 8'b00000000;

    // The i-cache BRAM IP has no byte-write enable. Preserve the untouched way
    // using the read port row, which is aligned with the miss/fill address by the wrapper.
    wire [63:0] icache_dina = wr_way1 ? {din, bram_dout[31:0]} : {bram_dout[63:32], din};

    generate
        if (USE_DCACHE_BRAM) begin : gen_dcache_data
            dcache_data_bram data_bram (
                .clka(clk),
                .ena(1'b1),
                .wea(dcache_wea),
                .addra(index),
                .dina(bram_dina),
                .clkb(clk),
                .enb(1'b1),
                .addrb(index),
                .doutb(bram_dout)
            );
        end else begin : gen_icache_data
            icache_data_bram data_bram (
                .clka(clk),
                .ena(1'b1),
                .wea(we),
                .addra(index),
                .dina(icache_dina),
                .clkb(clk),
                .enb(1'b1),
                .addrb(index),
                .doutb(bram_dout)
            );
        end
    endgenerate

    always @(*) begin
        hit = rd_hit0 || rd_hit1;
        if (rd_hit0) begin
            dout = bram_dout[31:0];
        end else if (rd_hit1) begin
            dout = bram_dout[63:32];
        end else begin
            dout = 32'b0;
        end
    end

    integer i;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n || flush) begin
            rd_index <= {INDEX_WIDTH{1'b0}};
            rd_tag   <= {TAG_WIDTH{1'b0}};
            rd_valid <= 1'b0;
            for (i = 0; i < DEPTH; i = i + 1) begin
                valid0[i] <= 1'b0;
                valid1[i] <= 1'b0;
                lru[i]    <= 1'b0;
            end
        end else begin
            rd_index <= index;
            rd_tag   <= tag;
            rd_valid <= 1'b1;

            if (we) begin
                if (wr_hit0) begin
                    lru[index] <= 1'b1;
                end else if (wr_hit1) begin
                    lru[index] <= 1'b0;
                end else if (wr_way0) begin
                    tag0[index]   <= tag;
                    valid0[index] <= 1'b1;
                    lru[index]    <= 1'b1;
                end else begin
                    tag1[index]   <= tag;
                    valid1[index] <= 1'b1;
                    lru[index]    <= 1'b0;
                end
            end else if (rd_hit0) begin
                lru[rd_index] <= 1'b1;
            end else if (rd_hit1) begin
                lru[rd_index] <= 1'b0;
            end
        end
    end
endmodule