RISCV_PREFIX ?= riscv64-unknown-elf-
CC      := $(RISCV_PREFIX)gcc
OBJDUMP := $(RISCV_PREFIX)objdump
OBJCOPY := $(RISCV_PREFIX)objcopy
PYTHON  ?= python3

ITERATIONS ?= 0
CPU_HZ ?= 75000000
COREMARK_PROGRESS_LOG ?= 1

TARGET := coremark
SRCS := \
	start.S \
	core_list_join.c \
	core_main.c \
	core_matrix.c \
	core_state.c \
	core_util.c \
	barebones/core_portme.c \
	barebones/ee_printf.c \
	barebones/cvt.c

CFLAGS := \
	-O2 \
	-march=rv32im \
	-mabi=ilp32 \
	-mcmodel=medany \
	-ffunction-sections \
	-fdata-sections \
	-fno-builtin \
	-fno-common \
	-DPERFORMANCE_RUN=1 \
	-DMAIN_HAS_NOARGC=1 \
	-DITERATIONS=$(ITERATIONS) \
	-DEE_TICKS_PER_SEC=$(CPU_HZ) \
	-DCOREMARK_PROGRESS_LOG=$(COREMARK_PROGRESS_LOG) \
	-Ibarebones \
	-I.

LDFLAGS := \
	-T link.ld \
	-nostartfiles \
	-nostdlib \
	-Wl,--gc-sections \
	-Wl,-Map,$(TARGET).map

.PHONY: all clean

all: $(TARGET).coe $(TARGET).mem $(TARGET).asm $(TARGET)_source.asm

$(TARGET).elf: $(SRCS) link.ld barebones/core_portme.h
	$(CC) $(CFLAGS) $(LDFLAGS) $(SRCS) -o $@ -lgcc

$(TARGET).asm: $(TARGET).elf
	$(OBJDUMP) -d $< > $@

$(TARGET)_source.asm: $(TARGET).elf
	$(OBJDUMP) -S $< > $@

$(TARGET).bin: $(TARGET).elf
	$(OBJCOPY) -O binary $< $@

$(TARGET).coe: $(TARGET).bin bin2coe.py
	$(PYTHON) bin2coe.py $< $@

$(TARGET).mem: $(TARGET).bin bin2mem.py
	$(PYTHON) bin2mem.py $< $@

clean:
	rm -f $(TARGET).elf $(TARGET).asm $(TARGET)_source.asm $(TARGET).bin \
	      $(TARGET).coe $(TARGET).mem $(TARGET).map
