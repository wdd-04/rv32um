    <Run Id="impl_trial_netdelay_high" Type="Ft2:EntireDesign" Part="xc7z020clg400-2" ConstrsSet="constrs_1" Description="To compensate for optimistic delay estimation, add extra delay cost to long distance and high fanout connections. (high setting, most pessimistic)" AutoIncrementalCheckpoint="false" WriteIncrSynthDcp="false" State="current" Dir="$PRUNDIR/impl_trial_netdelay_high" SynthRun="synth_1_copy_1" IncludeInArchive="true" IsChild="false" GenFullBitstream="true" AutoIncrementalDir="$PPRDIR/../riscv32_pipeline_cache/riscv32_pipeline.srcs/utils_1/imports/impl_trial_netdelay_high">
